<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TargetFramework, Nullable e ImplicitUsings vêm do Directory.Build.props da raiz.
    Não repita aqui: se um dia o valor mudar lá, este projeto ficaria para trás em silêncio.
  -->

  <ItemGroup>
    <!--
      OpenAPI/Swagger foi REMOVIDO do template de propósito:
      1. a fundação ainda não tem endpoint de negócio para documentar;
      2. o Microsoft.OpenApi 2.0.0 que vinha junto tem vulnerabilidade alta conhecida
         (GHSA-v5pm-xwqc-g5wc) e a versão corrigida (3.x) quebra o gerador do
         Microsoft.AspNetCore.OpenApi 10.0.5.
      Volta na sessão de endpoints (F4), conferindo as versões compatíveis na ocasião.
    -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Os helpers do host sao internal; os testes enxergam mesmo assim. -->
    <InternalsVisibleTo Include="FinanceMove.UnitTests" />
    <InternalsVisibleTo Include="FinanceMove.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\FinanceMove.Shared.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity.Contracts\FinanceMove.Modules.Identity.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity\FinanceMove.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Accounts.Contracts\FinanceMove.Modules.Accounts.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Accounts\Accounts\FinanceMove.Modules.Accounts.csproj" />
    <ProjectReference Include="..\Modules\Transactions\Transactions.Contracts\FinanceMove.Modules.Transactions.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Transactions\Transactions\FinanceMove.Modules.Transactions.csproj" />
    <ProjectReference Include="..\Modules\Budget\Budget.Contracts\FinanceMove.Modules.Budget.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Budget\Budget\FinanceMove.Modules.Budget.csproj" />
  </ItemGroup>

</Project>

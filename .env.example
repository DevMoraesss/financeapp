# Copie para .env e ajuste. O .env NUNCA vai para o git (está no .gitignore).
# Em produção (Railway), estes valores vivem nas variáveis de ambiente do serviço.

# Banco — bate com o docker-compose.yml (host 5435; 5432/5433/5434 já estão ocupadas nesta máquina)
ConnectionStrings__Postgres=Host=localhost;Port=5435;Database=financemove;Username=financemove;Password=financemove_dev

# Chave de assinatura do access token (JWT).
# Gere a sua com:  openssl rand -base64 48
Jwt__SigningKey=COLE-AQUI-A-SUA-CHAVE-NO-ARQUIVO-.env-NUNCA-NESTE
Jwt__Issuer=financemove
Jwt__Audience=financemove-spa

# Origem única permitida pelo CORS (ADR Decisão 4 — nunca use "*")
Cors__AllowedOrigin=http://localhost:5173

# Override do "hoje" para testes manuais de fatura e recorrência (SPEC §10).
# Deixe vazio no uso normal. Só funciona fora de Production.
# TEST_TODAY=2026-09-04
